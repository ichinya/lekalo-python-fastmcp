{
  "schema": "lekalo/contract-rules/v1",
  "requires": [
    "mcp.tools/v1"
  ],
  "bindings": {
    "python.decorated-object/v1": {
      "capability": "mcp.tools/v1",
      "fact": "tools",
      "files": [
        "server.py",
        "main.py"
      ],
      "constructor": "fastmcp.FastMCP",
      "methods": {
        "tool": "tool"
      }
    }
  },
  "checks": [
    {
      "id": "registered-tools",
      "schema": {
        "type": "object",
        "required": [
          "tools"
        ],
        "properties": {
          "tools": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "object",
              "required": [
                "name"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    }
  ]
}
