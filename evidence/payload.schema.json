{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FastMCP tool registration evidence",
  "type": "object",
  "required": ["name", "registration_path", "registration_line"],
  "additionalProperties": false,
  "properties": {
    "name": {"type": "string", "pattern": "^[A-Za-z0-9_.-]{1,128}$"},
    "registration_path": {"type": "string", "minLength": 1, "maxLength": 512},
    "registration_line": {"type": "integer", "minimum": 1, "maximum": 1000000}
  }
}
